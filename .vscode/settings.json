{
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.formatOnSave": true,
  "editor.rulers": [100],
  "eslint.probe": [
    "javascript",
    "javascriptreact",
    "json",
    "jsonc",
    "markdown",
    "typescript",
    "typescriptreact",
    "yaml"
  ],
  "js/ts.implicitProjectConfig.checkJs": false,
  "js/ts.tsdk.path": "node_modules/typescript/lib"
}
