{
  "name": "bingo-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Composable, testable, type-safe templates. 💝",
  "repository": {
    "type": "git",
    "url": "https://github.com/bingo-js/bingo"
  },
  "license": "MIT",
  "contributors": [
    {
      "name": "Josh Goldberg ✨",
      "email": "npm@joshuakgoldberg.com"
    },
    {
      "name": "michael faith",
      "url": "https://michael.faith"
    }
  ],
  "type": "module",
  "main": "./lib/index.js",
  "files": [
    "lib/"
  ],
  "scripts": {
    "build": "tsc -b",
    "format": "oxfmt",
    "lint": "eslint . --max-warnings 0",
    "lint:spelling": "cspell \"**\" \".github/**/*\"",
    "prepare": "simple-git-hooks",
    "site:build": "pnpm --filter=site build",
    "site:check": "pnpm --filter=site check",
    "site:dev": "pnpm --filter=site dev",
    "test": "vitest"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/js": "10.0.1",
    "@eslint/markdown": "8.0.3",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "@vitest/eslint-plugin": "1.6.28",
    "console-fail-test": "0.10.0",
    "cspell": "10.4.1",
    "eslint": "10.14.0",
    "eslint-plugin-jsdoc": "65.4.5",
    "eslint-plugin-jsonc": "3.4.2",
    "eslint-plugin-package-json": "1.14.0",
    "eslint-plugin-perfectionist": "5.13.0",
    "eslint-plugin-regexp": "3.3.3",
    "eslint-plugin-yml": "3.10.0",
    "jiti": "2.7.0",
    "knip": "6.45.1",
    "lint-staged": "17.6.0",
    "oxfmt": "0.78.0",
    "simple-git-hooks": "2.14.0",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  },
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
