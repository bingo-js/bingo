{
  "name": "bingo-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Composable, testable, type-safe templates. 💝",
  "repository": {
    "type": "git",
    "url": "https://github.com/bingo-js/bingo"
  },
  "license": "MIT",
  "author": {
    "name": "Josh Goldberg ✨",
    "email": "npm@joshuakgoldberg.com"
  },
  "type": "module",
  "main": "./lib/index.js",
  "files": [
    "lib/"
  ],
  "scripts": {
    "build": "tsc -b",
    "format": "oxfmt",
    "lint": "eslint . --max-warnings 0",
    "lint:packages": "pnpm dedupe --check",
    "lint:spelling": "cspell \"**\" \".github/**/*\"",
    "prepare": "husky",
    "site:build": "pnpm --filter=site build",
    "site:check": "pnpm --filter=site check",
    "site:dev": "pnpm --filter=site dev",
    "test": "vitest"
  },
  "lint-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.0",
    "@changesets/cli": "3.0.1",
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/js": "10.0.1",
    "@eslint/markdown": "8.0.3",
    "@types/node": "24.10.1",
    "@vitest/coverage-v8": "5.1.0",
    "@vitest/eslint-plugin": "1.6.28",
    "console-fail-test": "0.5.0",
    "cspell": "10.4.1",
    "eslint": "10.14.0",
    "eslint-plugin-jsdoc": "65.4.2",
    "eslint-plugin-jsonc": "3.4.2",
    "eslint-plugin-package-json": "1.14.0",
    "eslint-plugin-perfectionist": "5.13.0",
    "eslint-plugin-regexp": "3.3.3",
    "eslint-plugin-yml": "3.9.0",
    "husky": "9.1.7",
    "jiti": "2.7.0",
    "knip": "6.44.1",
    "lint-staged": "16.2.7",
    "oxfmt": "0.77.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  },
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "^22.15.0 || ^24.15.0 || >=26.0.0"
  }
}
