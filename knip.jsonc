{
	"$schema": "https://unpkg.com/knip@latest/schema.json",
	"ignoreExportsUsedInFile": { "interface": true, "type": true },
	"workspaces": {
		/**
		 * `bingo` and the `input-from-*` packages declare `zod` as a peer dependency
		 * with a default: a `dependencies` entry plus an optional peer on the same range.
		 * knip reports that optional peer as an issue, so these workspaces ignore `zod`.
		 * https://github.com/bingo-js/bingo/issues/475
		 */
		".": {
			"ignoreDependencies": ["@changesets/cli"]
		},
		"packages/bingo": {
			"entry": ["src/index.ts!"],
			"ignoreDependencies": ["zod"],
			"project": ["src/**/*.ts!"]
		},
		"packages/bingo-testers": {
			"entry": ["src/index.ts!"],
			"project": ["src/**/*.ts!"]
		},
		"packages/input-from-fetch": {
			"ignoreDependencies": ["zod"]
		},
		"packages/input-from-file": {
			"ignoreDependencies": ["zod"]
		},
		"packages/input-from-octokit": {
			"ignoreDependencies": ["zod"]
		},
		"packages/input-from-script": {
			"ignoreDependencies": ["zod"]
		},
		"packages/site": {
			"entry": ["astro.config.ts", "src/components/*.astro"],
			"ignoreDependencies": ["sharp"]
		}
	}
}
